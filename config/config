# 关闭当前焦点的split
keybind = ctrl+w=close_surface

# next/previous 按创建顺寻循环
keybind = ctrl+n=goto_split:next
keybind = ctrl+p=goto_split:previous

# 支持上下左右全方向可以自己绑定快捷键
# new split 
# 支持上下左右方向自己绑定 ctrl + shift + 方向键

keybind = ctrl+shift+left=new_split:left
keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+up=new_split:up
keybind = ctrl+shift+down=new_split:down

# 放大缩小当前的split alt +  
keybind = alt+left=resize_split:left,20
keybind = alt+right=resize_split:right,20

# 快速切换tab页面 ctrl + [ ]
keybind = ctrl+left_bracket=previous_tab
keybind = ctrl+right_bracket=next_tab


# 移动tab位置 ctrl + shift + [ ]
keybind = ctrl+shift+left_bracket=move_tab:-1
keybind = ctrl+shift+right_bracket=move_tab:+1

